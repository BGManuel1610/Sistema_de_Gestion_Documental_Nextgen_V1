# ==============================================================================
# Variables de Entorno - Sistema de Gestión Documental V1.1
# NextGen Development S.A.S.
# ==============================================================================

# ------------------------------------------------------------------------------
# PUERTOS Y SERVICIOS EXTERNOS (Host)
# ------------------------------------------------------------------------------
# Frontend React (por defecto 3000; si está ocupado, Vite hace fallback a 3001+)
FRONTEND_PORT=3000

# Backend FastAPI (por defecto 8000; alternativa si ocupado: 8001, 8080)
BACKEND_PORT=8000

# Rango / Puerto externo para MySQL anti-XAMPP:
# Utiliza el rango dinámico 3307-3309 para que Docker asigne automáticamente
# el primer puerto libre (3307, 3308 o 3309) sin colisionar con el 3306 de XAMPP.
DB_PORT_EXTERNAL=3307-3309

# ------------------------------------------------------------------------------
# BASE DE DATOS MYSQL (Configuración General)
# ------------------------------------------------------------------------------
DB_NAME=nextgen_gd_db
DB_USER=root
DB_PASSWORD=NextGen2026*

# Conexión desde el HOST (scripts locales en la máquina o herramientas como DBeaver)
DB_HOST=localhost
DB_PORT=3307

# Conexión INTERNA entre contenedores Docker (red bridge aislada)
DB_HOST_INTERNAL=nextgen_mysql
DB_PORT_INTERNAL=3306

# ------------------------------------------------------------------------------
# SEGURIDAD Y JWT
# ------------------------------------------------------------------------------
SECRET_KEY=nextgen_jwt_secret_super_segura_2026

# ------------------------------------------------------------------------------
# FRONTEND - COMUNICACIÓN CON LA API
# ------------------------------------------------------------------------------
# URL del backend accesible desde el navegador del usuario en el host
VITE_API_URL=http://localhost:8000
